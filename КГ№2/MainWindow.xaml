<Window x:Class="КГ_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:КГ_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="780" Width="1300"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- заголовок -->
            <RowDefinition Height="*"/>
            <!-- основная область -->
            <RowDefinition Height="Auto"/>
            <!-- кнопки -->
            <RowDefinition Height="160"/>
            <!-- лог -->
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Метод Z-буфера — пошаговая растеризация"
               FontSize="16" FontWeight="Bold"
               VerticalAlignment="Center"/>
            <TextBlock Text="  |  6 полигонов (3–6 рёбер), ортогональная проекция, scanline + Z-тест"
               Foreground="#666" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#555" BorderThickness="1" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="СЦЕНА (с подсветкой текущего шага)"
                       Style="{StaticResource Header}" Margin="8,6,8,4"/>
                    <Viewbox Stretch="Uniform" Margin="6">
                        <Grid Width="500" Height="500">
                            <Image x:Name="SceneImage"
                           Width="500" Height="500"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Canvas x:Name="OverlayCanvas" Width="500" Height="500"
                            IsHitTestVisible="False"/>
                        </Grid>
                    </Viewbox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="#555" BorderThickness="1" Margin="6,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                       Text="Z-БУФЕР (глубина: светлее = ближе)"
                       Style="{StaticResource Header}" Margin="8,6,8,4"/>
                    <Viewbox Stretch="Uniform" Margin="6">
                        <Image x:Name="ZBufferImage"
                       Width="500" Height="500"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Viewbox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="#555" BorderThickness="1" Margin="6,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <TextBlock Text="ТЕКУЩИЙ ШАГ" Style="{StaticResource Header}" FontSize="14"/>

                        <TextBlock Text="Полигон:" Style="{StaticResource Header}"/>
                        <TextBlock x:Name="PolyInfoText" Text="—" Style="{StaticResource Mono}" Margin="0,0,0,8"/>

                        <TextBlock Text="Вершины (3D → 2D):" Style="{StaticResource Header}"/>
                        <TextBlock x:Name="VerticesText" Text="—" Style="{StaticResource Mono}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="Строка y:" Style="{StaticResource Header}"/>
                        <TextBlock x:Name="RowText" Text="—" Style="{StaticResource Mono}" Margin="0,0,0,8"/>

                        <TextBlock Text="Интервалы на строке:" Style="{StaticResource Header}"/>
                        <TextBlock x:Name="SpansText" Text="—" Style="{StaticResource Mono}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="Пиксели строки:" Style="{StaticResource Header}"/>
                        <TextBlock x:Name="PixelsText" Text="—" Style="{StaticResource Mono}" Margin="0,0,0,8"/>

                        <Separator Margin="0,4,0,8"/>

                        <TextBlock Text="Последний Z-тест:" Style="{StaticResource Header}"/>
                        <TextBlock x:Name="ZTestText" Text="—" Style="{StaticResource Mono}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Separator Margin="0,4,0,8"/>

                        <TextBlock Text="Всего перезаписей:" Style="{StaticResource Header}"/>
                        <TextBlock x:Name="OverwriteText" Text="0" Style="{StaticResource Mono}" FontSize="16" FontWeight="Bold"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,8">
            <Button x:Name="StepButton"           Content="Шаг (строка)"   Click="StepButton_Click"/>
            <Button x:Name="AutoButton"           Content="Авто ▶"          Click="AutoButton_Click"/>
            <Button x:Name="ResetButton"          Content="Сброс"           Click="ResetButton_Click"/>
            <Button x:Name="ToggleCompareButton"  Content="Без Z-буфера"    Click="ToggleCompareButton_Click"/>

            <TextBlock Text="  Режим:" VerticalAlignment="Center" Foreground="#666" Margin="10,0,4,0"/>
            <TextBlock x:Name="ModeText" Text="Z-буфер включён"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Row="3" BorderBrush="#555" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ЛОГ" Style="{StaticResource Header}"
                           Margin="8,6,8,2"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                    <TextBox x:Name="LogText"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="11"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
    
</Window>
